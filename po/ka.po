msgstr "ახალი ხაზების ავტომატური სწორება"

#: src/nano.c:593
msgid "Scroll per half-screen, not per line"
msgstr "გადახვევა ნახევარი ეკრანით და არა ერთი ხაზით"

#: src/nano.c:594
msgid "Cut from cursor to end of line"
msgstr "ამოჭრა კურსორიდან ხაზის ბოლომდე"

#: src/nano.c:597
msgid "Show line numbers in front of the text"
msgstr "ხაზის ნომრების ჩვენება ტექსტის წინ"

#: src/nano.c:600
msgid "Enable the use of the mouse"
msgstr "თაგუნას გამოყენების ჩართვა"

#: src/nano.c:603
msgid "Do not read the file (only write it)"
msgstr "ფაილის არწაკითხვა (მხოლოდ ჩაწერა)"

