msgid "Fix Backspace/Delete confusion problem"
msgstr "Backspace/Delete-ის არევის პრობლემის გადაწყეტა"

#: src/nano.c:581
msgid "Keep the line below the title bar empty"
msgstr "სათაურის ზოლის ქვემოთ ხაზის ცარიელად შენარჩუნება"

#: src/nano.c:584
msgid "-f <file>"
msgstr "-f <ფაილი>"

#: src/nano.c:584
msgid "--rcfile=<file>"
msgstr "--rcfile=<ფაილი>"

#: src/nano.c:585
msgid "Use only this file for configuring nano"
