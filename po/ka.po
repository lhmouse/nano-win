msgid "-X <string>"
msgstr "-X <სტრიქონი>"

#: src/nano.c:564
msgid "--wordchars=<string>"
msgstr "--wordchars=<სტრიქონი>"

#: src/nano.c:565
msgid "Which other characters are word parts"
msgstr "რომელი სხვა სიმბოლოა სიტყვის ნაწილი"

#: src/nano.c:568
msgid "-Y <name>"
msgstr "-Y <სახელი>"

#: src/nano.c:568
msgid "--syntax=<name>"
msgstr "--syntax=<სახელი>"

