#: src/nano.c:628
msgid "Don't hard-wrap long lines [default]"
msgstr "Neaplauzt garas rindas [noklusējums]"

#: src/nano.c:630
msgid "Don't show the two help lines"
msgstr "Nerādīt divas palīdzības rindas"

#: src/nano.c:632
msgid "Make Ctrl+Right stop at word ends"
msgstr "Ctrl+Labā apstājas pie vārdu beigām"

#: src/nano.c:635
msgid "List the names of available syntaxes"
msgstr "Pieejamo sintakšu nosaukumu saraksts"

#: src/nano.c:638
msgid "Also try magic to determine syntax"
msgstr "Arī izmantot 'magic', lai noteiktu sintaksi"

#: src/nano.c:641
msgid "Accept 'filename:linenumber' notation"
msgstr "Pieņemt 'faila_nosaukums:rindas_numurs' apzīmējumu"

#: src/nano.c:642
msgid "Show some states on the title bar"
msgstr "Rādīt dažus statusus virsraksta joslā"

#: src/nano.c:643
msgid "Show a feedback bar at the bottom"
msgstr "Rādīt informācijas joslu apakšā"

