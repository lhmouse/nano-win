msgstr "Automātiski aplauzt pārāk garas rindas"

#: src/nano.c:578
msgid "Constantly show cursor position"
msgstr "Pastāvīgi rādīt kursora pozīciju"

#: src/nano.c:579
msgid "Fix Backspace/Delete confusion problem"
msgstr "Novērst neskaidrības ar Backspace/Delete taustiņiem"

#: src/nano.c:581
msgid "Keep the line below the title bar empty"
msgstr "Atstāt tukšu rindu zem virsrakstjoslas"

