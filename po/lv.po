msgstr "Neiespējami ar '%s'"

#: src/nano.c:201
msgid "Key is invalid in view mode"
msgstr "Taustiņš ir nederīgs skata režīmā"

#: src/nano.c:208
msgid "This function is disabled in restricted mode"
msgstr "Šī funkcija ir atspējota ierobežotajā režīmā"

#: src/nano.c:223
msgid "To suspend, type ^T^Z"
msgstr "Lai apturētu, ierakstiet ^T^Z"

#: src/nano.c:312
msgid "No file name"
msgstr "Nav norādīts faila nosaukums"

#: src/nano.c:314
msgid "Save modified buffer? "
msgstr "Saglabāt modificēto buferi? "

#: src/nano.c:339
#, c-format
