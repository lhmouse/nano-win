msgstr "--speller=<programma>"

#: src/nano.c:620
msgid "Use this alternative spell checker"
msgstr "Izmantot šo alternatīvo pareizrakstības pārbaudītāju"

#: src/nano.c:622
msgid "Save changes on exit, don't prompt"
msgstr "Saglabāt izmaiņas izejot, nejautājot"

#: src/nano.c:624
msgid "Save a file by default in Unix format"
msgstr "Pēc noklusējuma saglabāt failu Unix formātā"

#: src/nano.c:626
msgid "View mode (read-only)"
