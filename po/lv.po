#: src/nano.c:585
msgid "Use only this file for configuring nano"
msgstr "Izmantot tikai šo failu nano konfigurēšanai"

#: src/nano.c:588
msgid "Show cursor in file browser & help text"
msgstr "Rādīt kursoru failu pārlūkā un palīdzības tekstā"

#: src/nano.c:590
msgid "Show this help text and exit"
msgstr "Rādīt šo palīdzības tekstu un iziet"

#: src/nano.c:592
msgid "Automatically indent new lines"
msgstr "Automātiski veikt atkāpi jaunām rindām"

#: src/nano.c:593
msgid "Scroll per half-screen, not per line"
msgstr "Ritināt pa pusekrānam, nevis pa rindai"

#: src/nano.c:594
msgid "Cut from cursor to end of line"
msgstr "Izgriezt no kursora līdz rindas beigām"

#: src/nano.c:597
