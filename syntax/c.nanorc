## Syntax highlighting for C and C++ files.

syntax c "\.([ch](pp|xx)?|C|cc|c\+\+|cu|H|hh|ii?)$"
header "-\*-.*\<C(\+\+)?((;|[[:blank:]]).*)?-\*-"
magic "^(C|C\+\+) (source|program)"
comment "//"

# Macros.
color brightred "\<[A-Z_][0-9A-Z_]+\>"

# Keywords.
color green "\<(sizeof|typeid|enum|auto|static|register|const|volatile|struct|union|typedef|extern|inline)\>"
color green "\<(float|double|char|int|short|long|void|(un)?signed|_Complex|(b|_B)ool)\>"
color green "\<(_Imaginary|_Atomic|_Noreturn|_BitInt|_Decimal(32|64|128)|(wchar|char(8|16|32))_t)\>"
color green "\<(class|namespace|template|public|protected|private|typename|friend|virtual|noexcept|using|mutable|explicit|export)\>"
color green "\<((a|_A)lign(as|of)|decltype|const(expr|eval|init)|(t|_T)hread_local|(__)?restrict|typeof(_unqual)?)\>"
color green "\<(operator|new|delete|(static|dynamic|const|reinterpret)_cast|(s|_S)tatic_assert)\>"
color green "\<(concept|requires|co_(await|return|yield))\>"
color brightyellow "\<(for|if|while|do|else|case|default|switch|try|catch)\>"
color brightmagenta "\<(goto|continue|break|return|throw)\>"
color yellow "\<(true|false|this|nullptr|__func__)\>"

# Special identifiers.
color red "\<([[:lower:]][[:lower:]_]*|s?size|ptrdiff|u?int((_(fast|least))?(8|16|32|64)|ptr|max))_t\>"
color red "\<__m(64|(128|256|512)(d|i|h)?|mask(8|16|32|64))\>"
color red "\<(std(in|out|err)?|override|final|assert|errno)\>"

# Operators and punctuators.
color brightcyan "\<(defined|_Pragma|__has_include|_Generic)\>"
color cyan "[].+*/%=@&|!^~?:,;(){}<>[-]"
color cyan "\<((and|or|xor|not)(_eq)?|bit(and|or)|compl)\>"

# Literals.
color yellow "'([^'\]|(\\["'abefnrtv\\]))'" "'\\(([0-3]?[0-7]{1,2}))'" "'\\x[0-9A-Fa-f]{1,2}'"
color yellow ""(\\.|[^\\"])*?""
icolor yellow "\<[0-9]+(\.[0-9]*)?(e[+-]?[0-9]+)?(ul{0,2}|l{1,2}u?|f)?\>"
icolor yellow "\<0x[0-9a-f]+(\.[0-9a-f]*)?(p[+-]?[0-9]+)?(ul{0,2}|l{1,2}u?|f)?\>"
icolor yellow "\<0b[01]+(ul{0,2}|l{1,2}u?)?\>"

# Preprocessor directives.
color brightgreen "^[[:space:]]*#[[:space:]]*include(_next)?[[:space:]]+((<[^>]*>)|("[^"]*"))"
color brightcyan start="^[[:space:]]*#[[:space:]]*(if(n?def)?|elif|define|undef|warning|error|pragma)\>" end="(\`|[^\\])$"
color brightcyan "^[[:space:]]*#[[:space:]]*(else|endif|include(_next)?)?\>"

# GCC builtins.
color cyan "__attribute__[[:space:]]*\(\([^)]*\)\)"
color cyan "__declspec[[:space:]]*\([^)]*\)"

# Comments.
color brightblue "//[^"]*$|(^|[[:blank:]])//.*"
color brightblue start="/\*" end="\*/"

# Reminders.
color red,yellow "\<(FIXME|TODO|XXX)\>"

# Trailing whitespace.
color ,green "[[:space:]]+$"
